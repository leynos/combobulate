{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:combobulate:design:proof-evidence:2",
  "title": "Combobulate proof-evidence record, schema version 2",
  "description": "One record of evidence for one proof-obligation component. Schema validity does not establish the claim; the evidence gate (ADR-0009) decides the admission level. The if/then clauses enforce the gate's validity predicate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "component", "claim", "recorded_on", "evidence_kind", "outcome", "outcome_detail",
    "bounds", "binding", "method", "declared_assumptions", "trust_audit", "success_witnesses",
    "negative_controls", "verdict_source", "exception", "result_artefacts"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^EV-[0-9]{4}$"},
    "component": {"type": "string", "pattern": "^PF[0-9]{2}\\.[a-z][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "claim": {"$ref": "#/$defs/text"},
    "recorded_on": {"type": "string", "format": "date"},
    "evidence_kind": {"enum": ["deductive", "bounded", "test", "trust-declaration", "none"]},
    "outcome": {
      "enum": ["verified", "counterexample", "resource-exhausted", "solver-unknown", "unsupported", "skipped", "not-run", "tool-error"]
    },
    "outcome_detail": {"type": "string"},
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "statement"],
      "properties": {
        "kind": {"enum": ["not-applicable", "type-complete", "partial"]},
        "statement": {"type": "string"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable_digest", "specification_digest", "source_revision", "target", "features", "semantic_policy",
        "backend_profile", "implementation_relation"
      ],
      "properties": {
        "executable_digest": {"$ref": "#/$defs/optional_digest"},
        "specification_digest": {"$ref": "#/$defs/optional_digest"},
        "source_revision": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{40}$"}, {"type": "null"}]},
        "target": {"type": ["string", "null"]},
        "features": {"type": "array", "items": {"type": "string"}},
        "semantic_policy": {"type": ["string", "null"]},
        "backend_profile": {"type": ["string", "null"]},
        "implementation_relation": {"$ref": "#/$defs/text"}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "solver", "solver_version", "command", "run_mode"],
      "properties": {
        "tool": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "solver": {"type": ["string", "null"]},
        "solver_version": {"type": ["string", "null"]},
        "command": {"type": ["string", "null"]},
        "run_mode": {"enum": ["full-profile", "focused"]}
      }
    },
    "declared_assumptions": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "trust_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "items"],
      "properties": {
        "status": {"enum": ["audited", "unaudited"]},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item", "location", "covered_by"],
            "properties": {
              "item": {"$ref": "#/$defs/text"},
              "location": {"$ref": "#/$defs/text"},
              "covered_by": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "success_witnesses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "status"],
        "properties": {
          "id": {"$ref": "#/$defs/text"},
          "description": {"$ref": "#/$defs/text"},
          "status": {"enum": ["satisfied", "unsatisfied", "not-observed"]}
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "expected_failure", "observed"],
        "properties": {
          "id": {"$ref": "#/$defs/text"},
          "required": {"type": "boolean"},
          "expected_failure": {"$ref": "#/$defs/text"},
          "observed": {"enum": ["rejected-as-intended", "rejected-otherwise", "accepted", "not-run"]},
          "observed_failure": {"type": "string"}
        }
      }
    },
    "verdict_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "log"],
      "properties": {
        "kind": {"enum": ["log-parser", "self-reported"]},
        "log": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}}
            }
          ]
        }
      }
    },
    "exception": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^EXC-[0-9]{4}$"}]},
    "result_artefacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"evidence_kind": {"enum": ["deductive", "bounded", "test"]}}},
      "then": {"properties": {"outcome": {"not": {"const": "not-run"}}}},
      "else": {"properties": {"outcome": {"const": "not-run"}}}
    },
    {
      "if": {"properties": {"evidence_kind": {"const": "bounded"}}},
      "then": {"properties": {"bounds": {"properties": {"kind": {"enum": ["type-complete", "partial"]}}}}},
      "else": {"properties": {"bounds": {"properties": {"kind": {"const": "not-applicable"}}}}}
    },
    {
      "if": {"properties": {"verdict_source": {"properties": {"kind": {"const": "log-parser"}}}}},
      "then": {"properties": {"verdict_source": {"properties": {"log": {"type": "object"}}}}}
    }
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optional_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
  }
}
