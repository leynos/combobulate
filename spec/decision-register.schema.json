{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:combobulate:design:decision-register:0.2",
  "title": "Combobulate decision register",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "in_scope_questions", "decisions", "candidate_adrs"],
  "properties": {
    "revision": {"const": "0.2"},
    "in_scope_questions": {
      "type": "array",
      "items": {"$ref": "#/$defs/question"},
      "uniqueItems": true
    },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "roles"],
      "properties": {
        "decision": {"$ref": "#/$defs/decision_id"},
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sponsor", "technical-owner"],
          "properties": {
            "sponsor": {"$ref": "#/$defs/login"},
            "technical-owner": {"$ref": "#/$defs/login"}
          }
        }
      }
    },
    "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision"}},
    "candidate_adrs": {"type": "array", "items": {"$ref": "#/$defs/candidate_adr"}}
  },
  "$defs": {
    "decision_id": {"type": "string", "pattern": "^D[0-9]{2}$"},
    "question": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
    "login": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"},
    "adr_path": {"type": "string", "pattern": "^docs/adrs/adr-[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"},
    "adr_id": {"type": "string", "pattern": "^ADR-[0-9]{4}$"},
    "task": {"type": "string", "pattern": "^[1-9][0-9]*(?:\\.[1-9][0-9]*){1,2}$"},
    "text": {"type": "string", "minLength": 1},
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]$"},
        "summary": {"$ref": "#/$defs/text"}
      }
    },
    "approval_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "author_login", "names_decisions"],
      "properties": {
        "kind": {"enum": ["session", "pr-review", "pr-comment", "commit"]},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "author_login": {"$ref": "#/$defs/login"},
        "names_decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/decision_id"}
        },
        "answer": {"$ref": "#/$defs/text"}
      },
      "if": {"properties": {"kind": {"const": "session"}}},
      "then": {"required": ["answer"]}
    },
    "retired_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "text"],
      "properties": {
        "document": {
          "enum": [
            "docs/terms-of-reference.md",
            "docs/context.md",
            "docs/technical-design.md",
            "docs/language-reference.md",
            "docs/roadmap.md"
          ]
        },
        "text": {"$ref": "#/$defs/text"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "subject", "questions", "authority_roles", "options", "recommendation", "rationale",
        "lifecycle", "decided_option", "accepted_by", "accepted_on", "approval_reference", "adr",
        "supersedes", "superseded_by", "retired_statements"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/decision_id"},
        "subject": {"$ref": "#/$defs/text"},
        "questions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/question"}},
        "authority_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["sponsor", "technical-owner"]}
        },
        "options": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/option"}},
        "recommendation": {"type": "string", "pattern": "^[A-Z]$"},
        "rationale": {"$ref": "#/$defs/text"},
        "lifecycle": {"enum": ["proposed", "accepted", "superseded", "withdrawn"]},
        "decided_option": {"type": ["string", "null"], "pattern": "^[A-Z]$"},
        "accepted_by": {"oneOf": [{"$ref": "#/$defs/login"}, {"type": "null"}]},
        "accepted_on": {"type": ["string", "null"], "format": "date"},
        "approval_reference": {"oneOf": [{"$ref": "#/$defs/approval_reference"}, {"type": "null"}]},
        "adr": {"oneOf": [{"$ref": "#/$defs/adr_path"}, {"type": "null"}]},
        "supersedes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/decision_id"}},
        "superseded_by": {"oneOf": [{"$ref": "#/$defs/decision_id"}, {"type": "null"}]},
        "retired_statements": {"type": "array", "items": {"$ref": "#/$defs/retired_statement"}}
      },
      "allOf": [
        {
          "if": {"properties": {"lifecycle": {"enum": ["proposed", "withdrawn"]}}},
          "then": {
            "properties": {
              "decided_option": {"type": "null"},
              "accepted_by": {"type": "null"},
              "accepted_on": {"type": "null"},
              "approval_reference": {"type": "null"},
              "retired_statements": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"lifecycle": {"enum": ["accepted", "superseded"]}}},
          "then": {
            "properties": {
              "decided_option": {"type": "string"},
              "accepted_by": {"$ref": "#/$defs/login"},
              "accepted_on": {"type": "string"},
              "approval_reference": {"$ref": "#/$defs/approval_reference"}
            }
          }
        },
        {
          "if": {"properties": {"lifecycle": {"const": "superseded"}}},
          "then": {"properties": {"superseded_by": {"$ref": "#/$defs/decision_id"}}},
          "else": {"properties": {"superseded_by": {"type": "null"}}}
        }
      ]
    },
    "candidate_adr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "source", "decision", "disposition"],
      "properties": {
        "id": {"type": "string", "pattern": "^CA[1-9][0-9]*$"},
        "subject": {"$ref": "#/$defs/text"},
        "source": {"$ref": "#/$defs/text"},
        "decision": {"$ref": "#/$defs/decision_id"},
        "disposition": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "adrs"],
              "properties": {
                "kind": {"const": "adr"},
                "adrs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/adr_id"}}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "task"],
              "properties": {
                "kind": {"const": "deferred"},
                "task": {"$ref": "#/$defs/task"},
                "bet": {"type": "string", "pattern": "^B[0-9]{2}$"}
              }
            }
          ]
        }
      }
    }
  }
}
