  "capabilities": [
    {
      "id": "PC01",
      "name": "Explicit Rust engine selection and positional ordering",
      "status": "documented-upstream-opportunity",
      "refusal_rule": "An engine choice and ordering guarantee cannot be inferred from Python defaults."
    },
    {
      "id": "PC02",
      "name": "Streaming partition, prefix, halo, and segment contracts",
      "status": "documented-upstream-opportunity",
      "refusal_rule": "Unavailable kernel partition contracts exclude that streaming lowering."
    },
    {
      "id": "PC03",
      "name": "Spill permission, quota, control scope, and cleanup",
      "status": "documented-upstream-opportunity",
      "refusal_rule": "Default no unrequested disk; strict profile refuses an unenforceable guarantee."
    },
    {
      "id": "PC04",
      "name": "Operation-specific out-of-core execution",
      "status": "documented-upstream-opportunity",
      "refusal_rule": "Do not infer join/group-by spilling from sorting support."
    },
    {
      "id": "PC05",
      "name": "Empty/nested validity and schema semantics",
      "status": "documented-upstream-opportunity",
      "refusal_rule": "Combobulate schemas remain authoritative even when backend empty results use Null dtype."
    },
    {
      "id": "PC06",
      "name": "Dtype and extension-metadata planning specialization",
      "status": "documented-upstream-opportunity",
      "refusal_rule": "Backend plan-time callbacks are not Rust compile-time execution; extension tags are not domain proofs."
    },
    {
      "id": "PC07",
      "name": "Deterministic plugin optimizer participation",
      "status": "documented-upstream-opportunity",
      "refusal_rule": "Determinism alone cannot authorize speculation, skipped failures or merged effects."
    },
    {
      "id": "PC08",
      "name": "Physical node to source provenance",
      "status": "documented-upstream-opportunity",
      "refusal_rule": "Retain own source mapping when an optional backend hook is unavailable."
    },
    {
      "id": "PC09",
      "name": "Strict table boundary and extension representation",
      "status": "documented-upstream-opportunity",
      "refusal_rule": "Explicit local policies remain authoritative; Map does not replace ordered segments."
    }
  ],
