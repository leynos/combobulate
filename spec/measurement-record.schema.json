{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:combobulate:design:measurement-record:0.2",
  "title": "Combobulate calibration or acceptance measurement record",
  "description": "Hardware is described by class only (decision D11): no host names, user names, or paths outside the repository.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "purpose", "control_ids", "control_digest", "recorded_on", "hardware", "toolchains", "workloads"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "purpose": {"enum": ["calibration", "acceptance"]},
    "control_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^AC-[0-9]{2}$"}
    },
    "control_digest": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
    "recorded_on": {
      "type": "string",
      "format": "date",
      "description": "Acceptance measurement date, not the later date when its record is committed."
    },
    "runner_image": {"const": "ubuntu-24.04"},
    "runner_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_os", "image_version"],
      "properties": {
        "image_os": {"type": "string", "minLength": 1},
        "image_version": {"type": "string", "minLength": 1}
      },
      "description": "Observed GitHub Actions ImageOS and ImageVersion values."
    },
    "outcome": {"enum": ["pass", "fail", "budget-exceeded", "resource-exhausted", "inconclusive", "missing"]},
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "cpu_model", "cores", "threads", "memory_gib", "os_family", "kernel_major"],
      "properties": {
        "class": {"enum": ["shared-development-host", "github-hosted-runner"]},
        "cpu_model": {"type": "string", "minLength": 1},
        "cores": {"type": "integer", "minimum": 1},
        "threads": {"type": "integer", "minimum": 1},
        "vcpus": {"type": "integer", "minimum": 1},
        "memory_gib": {"type": "integer", "minimum": 1},
        "architecture": {"enum": ["x64", "arm64"]},
        "os_family": {"type": "string", "minLength": 1},
        "kernel_major": {"type": "integer", "minimum": 1}
      }
    },
    "toolchains": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "conditions": {"type": "string", "minLength": 1},
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "command", "metric", "unit", "samples", "median"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "metric": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "samples": {
            "type": "array",
            "items": {
              "oneOf": [
                {"type": "number", "minimum": 0},
                {"type": "string", "minLength": 1}
              ]
            }
          },
          "median": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "string", "minLength": 1}]},
          "notes": {"type": "string", "minLength": 1},
          "attempts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["run_id", "run_number", "attempt", "conclusion", "wall_seconds", "started_at", "completed_at", "url"],
              "properties": {
                "run_id": {"type": "string", "pattern": "^[0-9]+$"},
                "run_number": {"type": "integer", "minimum": 1},
                "attempt": {"type": "integer", "minimum": 1},
                "conclusion": {
                  "enum": ["success", "failure", "cancelled", "timed_out", "action_required", "neutral", "skipped", "stale", "startup_failure"]
                },
                "wall_seconds": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
                "started_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
                "completed_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
                "url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"}
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"purpose": {"const": "acceptance"}}},
      "then": {
        "required": ["outcome", "runner_image", "runner_metadata"],
        "properties": {
          "control_ids": {"maxItems": 1},
          "control_digest": {"type": "string"},
          "hardware": {
            "required": ["vcpus", "memory_gib", "architecture"],
            "properties": {
              "class": {"const": "github-hosted-runner"},
              "os_family": {"const": "Ubuntu 24.04"},
              "threads": {"const": 4},
              "vcpus": {"const": 4},
              "memory_gib": {"const": 16},
              "architecture": {"const": "x64"}
            }
          }
        }
      },
      "else": {
        "not": {"required": ["outcome"]},
        "properties": {"control_digest": {"type": "null"}}
      }
    },
    {
      "if": {
        "properties": {
          "purpose": {"const": "acceptance"},
          "control_ids": {"contains": {"const": "AC-07"}}
        },
        "required": ["purpose", "control_ids"]
      },
      "then": {
        "properties": {
          "workloads": {
            "items": {
              "if": {
                "properties": {"id": {"const": "ci-build-test"}},
                "required": ["id"]
              },
              "then": {
                "required": ["attempts"],
                "properties": {"attempts": {"minItems": 1}},
                "allOf": [
                  {
                    "if": {
                      "properties": {"samples": {"maxItems": 0}},
                      "required": ["samples"]
                    },
                    "then": {
                      "properties": {"median": {"const": "not available"}}
                    }
                  }
                ]
              },
              "else": {
                "properties": {"samples": {"minItems": 1}}
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "workloads": {"items": {"properties": {"samples": {"minItems": 1}}}}
        }
      }
    }
  ]
}
