{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:combobulate:design:acceptance-controls:0.2",
  "title": "Combobulate pre-registered acceptance controls",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "frozen_fields", "outcome_verdicts", "controls"],
  "properties": {
    "revision": {"const": "0.2"},
    "frozen_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "outcome_verdicts": {
      "type": "object",
      "additionalProperties": {"enum": ["pass", "fail", "inconclusive"]}
    },
    "controls": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/control"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "tasks", "requirements", "frozen", "registered_digest", "digest", "amendments"],
      "properties": {
        "id": {"type": "string", "pattern": "^AC-[0-9]{2}$"},
        "title": {"$ref": "#/$defs/text"},
        "tasks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "registered_digest": {"$ref": "#/$defs/digest"},
        "digest": {"$ref": "#/$defs/digest"},
        "frozen": {
          "type": "object",
          "required": ["workload", "decision_rule", "environment", "calibration", "registered_on", "authority"],
          "properties": {
            "workload": {
              "type": "object",
              "required": ["description", "sources"],
              "properties": {
                "description": {"$ref": "#/$defs/text"},
                "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
              }
            },
            "decision_rule": {
              "type": "object",
              "required": ["thresholds", "pass_when", "inconclusive", "extension"],
              "properties": {
                "thresholds": {"type": "object", "minProperties": 1},
                "pass_when": {"$ref": "#/$defs/text"},
                "inconclusive": {"$ref": "#/$defs/text"},
                "extension": {"$ref": "#/$defs/text"}
              }
            },
            "environment": {
              "type": "object",
              "required": ["image", "runner_class", "toolchains"],
              "properties": {"image": {"const": "ubuntu-24.04"}, "runner_class": {"$ref": "#/$defs/text"}}
            },
            "calibration": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "record", "derivation"],
                  "properties": {
                    "status": {"const": "calibrated"},
                    "record": {"type": "string", "pattern": "^spec/calibration/[a-z0-9-]+\\.json$"},
                    "derivation": {"$ref": "#/$defs/text"}
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "reason"],
                  "properties": {"status": {"const": "not-calibrated"}, "reason": {"$ref": "#/$defs/text"}}
                }
              ]
            },
            "registered_on": {"type": "string", "format": "date"},
            "authority": {"$ref": "#/$defs/text"}
          }
        },
        "amendments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "approved_by", "approval_reference", "replaces", "new_digest", "reason"],
            "properties": {
              "date": {"type": "string", "format": "date"},
              "approved_by": {"$ref": "#/$defs/text"},
              "approval_reference": {"type": "string", "pattern": "^https://"},
              "replaces": {"$ref": "#/$defs/digest"},
              "new_digest": {"$ref": "#/$defs/digest"},
              "reason": {"$ref": "#/$defs/text"}
            }
          }
        }
      }
    }
  }
}
